{
  "name": "klecks",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "icons": "tauri icon assets/app-icon.svg && tauri icon assets/app-icon-windows.svg -o .icons-win && cp .icons-win/icon.ico .icons-win/Square*.png .icons-win/StoreLogo.png src-tauri/icons/ && rm -rf .icons-win src-tauri/icons/android src-tauri/icons/ios",
    "pack": "tauri build",
    "landing": "vite build --config vite.landing.config.ts"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "lucide": "^1.60.0"
  }
}
