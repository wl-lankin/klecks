{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klecks",
  "version": "0.1.0",
  "identifier": "de.wlankin.klecks",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Klecks",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "dragDropEnabled": false,
        "backgroundColor": "#0d0d11"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1430 http://localhost:1430"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Modern paint and screenshot markup",
    "copyright": "\u00a9 2026 Wolfgang Linz",
    "publisher": "Wolfgang Linz",
    "homepage": "https://wolfgang-linz.de",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyRjU0Q0NEQ0M5MEJBQTkKUldTcHVwRE16VXoxTXBucU5nZzJqNDhyVEMycmhLTHJMbXBJc09na0JuUUVvenQvd0twTXhCbEwK",
      "endpoints": [
        "https://github.com/wl-lankin/klecks/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}